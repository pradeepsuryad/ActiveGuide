.venv/
__pycache__/
*.pyc
logs/*.png
logs/*.csv

# Demo output artifacts (regenerable via demo_phase0.py / demo_phase1.py)
logs/

# dVRK PSM assets fetched from upstream (WPI-AIM/dvrk_env) and everything
# derived from them. Not redistributed here: that repo has no LICENSE file
# (GitHub reports license: null) even though dvrk_description/package.xml
# declares BSD. Regenerate with:  python tools/build_psm.py --fetch
model/psm/psm.urdf.xacro
model/psm/psm.urdf
model/psm/meshes/
model/psm.xml

# Baked anatomy. Regenerable offline in seconds and the .npz is megabytes, so
# it is derived rather than tracked:  python tools/build_anatomy.py
# (demo_phase3 also bakes it on first run if it is missing).
model/anatomy_sdf.npz
model/anatomy.stl

# Python packaging
*.egg-info/
build/
dist/
